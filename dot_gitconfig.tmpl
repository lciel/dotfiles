[user]
	name = {{ .name }}
	email = {{ .email }}
{{- if .signingkey }}
	signingkey = {{ .signingkey }}
{{- end }}
[core]
    pager = lv -c
    editor = nvim
	excludesfile = {{ .chezmoi.homeDir }}/.gitignore_global
[color]
    ui = auto
    status = auto
    diff = auto
    branch = auto
    interactive = auto
    grep = auto
[alias]
    tr = log --graph --pretty='format:%C(yellow)%h%Creset %s %Cgreen(%an)%Creset %Cred%d%Creset'
    st = status
    sh = show
    ci = commit -a
    co = checkout
    br = branch
    ba = branch -a
    dm = diff master
    dw = diff --color-words
    dc = diff --cached
    d1 = diff HEAD~
    d2 = diff HEAD~~
    d3 = diff HEAD~~~
    d4 = diff HEAD~~~~
    d5 = diff HEAD~~~~~
    gr = grep
    gn = grep -n
[include]
    path = ~/.gitconfig.local
[commit]
	template = {{ .chezmoi.homeDir }}/.stCommitMsg
{{- if .signingkey }}
	gpgsign = true
{{- end }}
[gpg]
	program = gpg
[credential]
{{- if eq .chezmoi.os "darwin" }}
	helper = osxkeychain
{{- else }}
	helper = store
{{- end }}
# GitHub auth via gh (written by `gh auth setup-git`; kept here so
# `chezmoi apply` does not wipe it). Resolved from PATH, not hardcoded.
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
