{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
set -euo pipefail

# =============================================================================
# macOS package setup (run once by chezmoi)
#
# Counterpart to run_once_install-packages-linux.sh.tmpl. Installs Homebrew if
# missing, then everything in osx/Brewfile. Both steps may prompt for sudo.
# =============================================================================

BREWFILE="{{ .chezmoi.sourceDir }}/osx/Brewfile"

# Homebrew
if ! command -v brew &>/dev/null; then
  echo "==> Installing Homebrew"
  NONINTERACTIVE=1 /bin/bash -c \
    "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

# Apple Silicon and Intel install to different prefixes
if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

# Packages.
#   --no-upgrade: install what is missing, never touch what is already there.
#     On a fresh machine this changes nothing (everything is missing anyway),
#     but it keeps a re-run from mass-upgrading a working toolchain — and from
#     replacing running apps, which kills them. Upgrade deliberately instead:
#     `brew upgrade`.
#   --adopt: let a cask take over an app already sitting in /Applications
#     instead of failing.
if [ -f "$BREWFILE" ]; then
  echo "==> brew bundle install ($BREWFILE)"
  HOMEBREW_CASK_OPTS="--adopt" brew bundle install --no-upgrade --file="$BREWFILE" || \
    echo "!! brew bundle reported failures — rerun manually to see which" >&2
else
  echo "!! Brewfile not found at $BREWFILE — skipping brew bundle" >&2
fi

# GNU screen needs this directory to exist (SCREENDIR is set in .zshrc)
mkdir -p ~/.screen
chmod 700 ~/.screen

# Runtimes declared in ~/.config/mise/config.toml
if command -v mise &>/dev/null; then
  echo "==> mise install"
  mise install
fi

# rustup toolchain (the brew formula only ships the installer)
if command -v rustup-init &>/dev/null && [ ! -d "$HOME/.rustup/toolchains" ]; then
  rustup-init -y --no-modify-path
fi

cat <<'EOF'

Done! Remaining manual steps:
  - gh auth login          (git credential helper is already configured)
  - gpg key import         (if you sign commits)
  - iTerm2: import dot_iterm2/com.googlecode.iterm2.plist
  - tmux: prefix + I       (install TPM plugins)
EOF
{{ end -}}
