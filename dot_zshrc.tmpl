## Environment
export LANG=ja_JP.UTF-8
export EDITOR=nvim
export GPG_TTY=$(tty)
export WCWIDTH_CJK_LEGACY=yes

## Emoji (for SSH indicator in prompt / tmux window)
export SSH_EMOJI=$'\U26A1'

## Prompt
# PROMPT / PROMPT2 come from starship, initialised in the Tools section below.
# There is deliberately no ~/.config/starship.toml: we run starship's stock
# preset, which needs a Nerd Font (see osx/Brewfile — font-udev-gothic-nf).
# Only the spell-correction prompt is set here, as starship ignores SPROMPT.
SPROMPT="%F{198}%r is correct? [n,y,a,e]:%f "

# Drop the right prompt from lines that have already been submitted, so
# re-prompt below cannot leave stale segments scrolling up the screen.
setopt transient_rprompt

re-prompt() {
    zle .reset-prompt
    zle .accept-line
}
zle -N accept-line re-prompt

## Options
setopt auto_cd
setopt auto_pushd
setopt correct
setopt list_packed
setopt noautoremoveslash
setopt nolistbeep

## Keybindings (emacs mode)
bindkey -e
autoload history-search-end
zle -N history-beginning-search-backward-end history-search-end
zle -N history-beginning-search-forward-end history-search-end
bindkey "^p" history-beginning-search-backward-end
bindkey "^n" history-beginning-search-forward-end

## History
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt hist_ignore_dups
setopt share_history

## Completion
autoload -U compinit
compinit

## Window title (tmux integration)
# Deliberately does NOT rename tmux windows any more. A tab is a workspace that
# is named by hand and kept (Daily, Research, Incident, a project, ...), each
# holding its own long-running Claude session; renaming it to whatever command
# just ran would erase that. .tmux.conf enforces the same with allow-rename off.
# What the window shows instead is Claude's state, published by the hooks in
# ~/.claude/settings.json — see @claude_state in .tmux.conf.

ssh() {
  if [ "$(ps -p $(ps -p $$ -o ppid=) -o comm=)" = "tmux" ]; then
    local window_name=$(tmux display -p '#{window_name}')
    tmux rename-window "ssh ${SSH_EMOJI} ${@: -1}"
    command ssh "$@"
    tmux rename-window $window_name
  else
    command ssh "$@"
  fi
}

## Aliases
setopt complete_aliases

alias where="command -v"
alias j="jobs -l"

case "${OSTYPE}" in
freebsd*|darwin*)
  alias ls="ls -G -w"
  ;;
linux*)
  alias ls="ls --color"
  ;;
esac

alias la="ls -a"
alias lf="ls -F"
alias ll="ls -l"
alias du="du -h"
alias df="df -h"
alias su="su -l"

alias -g G="| grep"
alias -g W="| wc"
alias -g H="| head"
alias -g T="| tail"

if command -v gls > /dev/null 2>&1; then
    alias ls="gls --color=auto"
fi

## Terminal / colors
# Inside tmux, TERM is tmux's to set (see default-terminal in .tmux.conf);
# overriding it here would advertise capabilities the tmux pane does not have.
if [ -z "$TMUX" ]; then
    export TERM=xterm-256color
fi

if command -v gdircolors > /dev/null 2>&1; then
    eval $(gdircolors ~/.zsh/dircolors-solarized/dircolors.ansi-universal)
elif command -v dircolors > /dev/null 2>&1; then
    eval $(dircolors ~/.zsh/dircolors-solarized/dircolors.ansi-universal)
fi

export LSCOLORS=exfxcxdxbxegedabagacad
export LS_COLORS='di=34:ln=35:so=32:pi=33:ex=31:bd=46;34:cd=43;34:su=41;30:sg=46;30:tw=42;30:ow=43;30'
zstyle ':completion:*' list-colors \
    'di=34' 'ln=35' 'so=32' 'ex=31' 'bd=46;34' 'cd=43;34'

## OS-specific
{{ if eq .chezmoi.os "darwin" -}}
# Homebrew
eval "$(/opt/homebrew/bin/brew shellenv)"

# macOS screen directory
export SCREENDIR=~/.screen
{{- end }}

## Tools

# mise (replaces rbenv, pyenv, nodenv, goenv)
eval "$(mise activate zsh)"

# direnv
eval "$(direnv hook zsh)"

# zoxide (replaces z)
eval "$(zoxide init zsh)"

# fzf
source <(fzf --zsh)

# uv
[ -f "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"

# Google Cloud SDK (the gcloud-cli cask installs under the Homebrew prefix;
# the standalone tarball installs under $HOME)
for _gcloud_dir in {{ if eq .chezmoi.os "darwin" }}/opt/homebrew/share/google-cloud-sdk {{ end }}"$HOME/google-cloud-sdk"; do
  if [ -f "$_gcloud_dir/path.zsh.inc" ]; then
    source "$_gcloud_dir/path.zsh.inc"
    [ -f "$_gcloud_dir/completion.zsh.inc" ] && source "$_gcloud_dir/completion.zsh.inc"
    break
  fi
done
unset _gcloud_dir

## Plugins (sheldon)
eval "$(sheldon source)"

## Prompt (starship) — must come after sheldon, which loads prompt-touching plugins
eval "$(starship init zsh)"

## User config
[ -f ~/.zsh/func.zsh ] && source ~/.zsh/func.zsh
[ -f ~/.zshrc.local ] && source ~/.zshrc.local
