# Install with: brew bundle install --file=osx/Brewfile
# All entries live in homebrew/core and homebrew/cask — no extra taps needed.

# Fonts
# UDEV Gothic NF is the terminal font: JetBrains Mono + BIZ UDGothic, with Nerd
# Font glyphs for starship's stock preset and a strict 1:2 half/full width ratio
# so CJK stays aligned (see WCWIDTH_CJK_LEGACY in .zshrc).
cask "font-udev-gothic-nf"
cask "font-ricty-diminished"

# Core CLI tools
brew "chezmoi"
brew "coreutils"
brew "curl"
brew "git"
brew "git-lfs"
brew "gh"
brew "jq"
brew "lv"      # .gitconfig uses `lv -c` as the git pager
brew "tree"

# Shell
brew "starship"
brew "sheldon"
brew "zoxide"
brew "fzf"
brew "direnv"

# Runtime management
brew "mise"

# Editor
brew "neovim"

# Terminal multiplexer
brew "tmux"

# Security
brew "gnupg"
brew "pinentry-mac"

# Cloud & infra
brew "awscli"

# Build tools
brew "automake"
brew "cmake"
brew "rustup"
brew "gawk"

# Media / archives
brew "ffmpeg"
brew "sevenzip"

# Terminals
cask "iterm2"
cask "cmux"

# Editors & AI clients
cask "cursor"
