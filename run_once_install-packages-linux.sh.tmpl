{{- if eq .chezmoi.os "linux" -}}
#!/bin/bash
set -euo pipefail

# =============================================================================
# Ubuntu/Debian package setup (run once by chezmoi)
# =============================================================================

if ! command -v apt-get &>/dev/null; then
  echo "Skipping: apt-get not found (not Debian/Ubuntu)"
  exit 0
fi

sudo apt-get update

# Locale (ja_JP.UTF-8 used in zshrc)
sudo apt-get install -y locales
sudo locale-gen ja_JP.UTF-8

# Core CLI tools
sudo apt-get install -y \
  curl \
  git \
  git-lfs \
  jq \
  tree \
  gnupg \
  gawk

# Build tools
sudo apt-get install -y \
  build-essential \
  automake \
  cmake

# Shell
sudo apt-get install -y zsh
if [ "$(basename "$SHELL")" != "zsh" ]; then
  chsh -s "$(which zsh)"
fi

# Terminal multiplexer
sudo apt-get install -y tmux

# Clipboard support (for tmux)
sudo apt-get install -y xclip

# --- Tools not in apt: install via their official methods ---

# chezmoi (already installed if running this script, but ensure latest)
if ! command -v chezmoi &>/dev/null; then
  sh -c "$(curl -fsLS get.chezmoi.io)"
fi

# neovim (snap for latest stable; 0.10+ required by nvim-treesitter)
if ! command -v snap &>/dev/null; then
  sudo apt-get install -y snapd
fi
sudo snap install nvim --classic

# fzf (0.48+ required for --zsh flag; apt version is too old)
if [ ! -d ~/.fzf ]; then
  git clone --depth 1 https://github.com/junegunn/fzf.git ~/.fzf
fi
~/.fzf/install --bin
ln -sf ~/.fzf/bin/fzf ~/.local/bin/fzf

# direnv
if ! command -v direnv &>/dev/null; then
  sudo apt-get install -y direnv
fi

# zoxide
if ! command -v zoxide &>/dev/null; then
  curl -sSfL https://raw.githubusercontent.com/ajeetdsouza/zoxide/main/install.sh | sh
fi

# mise (runtime manager)
if ! command -v mise &>/dev/null; then
  curl https://mise.run | sh
fi

# sheldon (zsh plugin manager)
if ! command -v sheldon &>/dev/null; then
  curl --proto '=https' -fLsS https://rossmacarthur.github.io/install/crate.sh \
    | bash -s -- --repo rossmacarthur/sheldon --to ~/.local/bin
fi

# starship (prompt)
if ! command -v starship &>/dev/null; then
  curl -sS https://starship.rs/install.sh | sh -s -- --yes --bin-dir ~/.local/bin
fi

# rustup
if ! command -v rustup &>/dev/null; then
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
fi

echo "Done! You may need to restart your shell."
{{ end -}}
